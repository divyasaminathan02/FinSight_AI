# ==============================================================================
# FinSight AI - Enterprise Production Environment Configuration
# ==============================================================================
# Copy this file to .env and configure the secrets appropriately for your environment.
# NEVER commit the actual .env file with sensitive credentials to version control.

# Database Connection (Supports PostgreSQL, MySQL, or local SQLite fallback)
DATABASE_URL=postgresql://finsight_user:ChangeMePassword123@localhost:5432/finsight_enterprise_db
# Local SQLite fallback example:
# DATABASE_URL=sqlite:///./backend/finsight.db

# JWT Authentication & RBAC Security
JWT_SECRET=super-secret-jwt-signing-key-minimum-32-chars-for-hs256-security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM & Copilot Agent Intelligence
# Accepts Google Gemini, OpenAI, Anthropic, or Ollama local endpoints
LLM_PROVIDER=gemini
LLM_API_KEY=AIzaSyFakeKeyForDemonstration_ReplaceWithRealGeminiKey
LLM_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.2

# MLflow Experiment Tracking & Model Registry
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=FinSight_NBFC_Intelligence_Production
MLFLOW_ARTIFACT_STORE=./backend/ml/models/artifacts

# Vector DB & RAG Knowledge Base Settings
VECTOR_DB_TYPE=chromadb
CHROMA_PERSIST_DIRECTORY=./backend/app/rag/chroma_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cloud Object Storage (AWS S3) - Only required for enterprise document storage
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=ap-south-1
S3_BUCKET_NAME=finsight-loan-documents-prod

# Redis / Cache Layer (Optional high-throughput caching)
REDIS_URL=redis://localhost:6379/0

# Server & Security Configuration
ENVIRONMENT=production
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,finsight.ai,*.finsight.ai
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://app.finsight.ai
RATE_LIMIT_PER_MINUTE=180
