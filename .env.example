# ==============================================================================
# FinSight AI - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust variables as appropriate.
# NEVER commit .env with real secrets to version control.

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="FinSight AI - NBFC Intelligence Platform"
VERSION="1.0.0"

# Security & JWT
SECRET_KEY=finsight-ai-enterprise-secret-key-super-secure-jwt-2026-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default (used out-of-the-box):
DATABASE_URL=sqlite:///./backend/finsight.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/finsight_ai

# RAG & pgvector Configuration (Optional)
# If set, RAG knowledge embeddings use pgvector; otherwise falls back to local fast semantic embedding store
# PGVECTOR_URL=postgresql://postgres:password@localhost:5432/finsight_pgvector

# LLM Provider Configuration
# Supported providers: gemini | openai | anthropic | local_expert
LLM_PROVIDER=gemini

# Provider API Keys (Set the key corresponding to LLM_PROVIDER)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# MLflow Tracking Store
MLFLOW_TRACKING_URI=sqlite:///backend/ml/models/mlflow.db

# Institutional Baseline Parameters (₹ Cr)
AUM_BASELINE_CR=842.60
LOAN_PORTFOLIO_CR=718.20
AVAILABLE_LIQUIDITY_CR=126.40
FRAUD_EXPOSURE_CR=2.80
COLLECTION_EFFICIENCY_BASELINE=94.70
